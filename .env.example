# App
NODE_ENV= production
BASE_URL= http://localhost:3000
PORT= 3000

# Package
PACKAGE_NAME=rag
PACKAGE_VERSION=latest

# Database
MONGODB_URI= mongodb://root:root@mongodb:27017/rag_db?authSource=admin

# Mongo root credentials
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=root

# Mongo-Express auth
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASS=admin

# JWT
JWT_SECRET=secret
JWT_EXPIRES_IN=90d

# Ollama (for RAG). Use a smaller model (e.g. phi3, gemma2:2b, qwen2:1.5b) on low-spec devices.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Seed Admin
SUPER_ADMIN_EMAIL=superadmin@gmail.com
SUPER_ADMIN_PASS=superadmin